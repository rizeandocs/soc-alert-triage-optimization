   "source": [
    "df['cost_savings'] = df['daily_labor_cost'].max() - df['daily_labor_cost']\n",
    "\n",
    "# Check for missing values\n",
    "print(\"Missing values:\")\n",
    "print(df.isnull().sum())\n",
    "\n",
    "# Check data types\n",
    "print(\"\\nData types:\")\n",
    "print(df.dtypes)\n",
    "\n",
    "# Basic statistics\n",
    "print(\"\\nBasic statistics:\")\n",
    "print(df.describe())\n",
    "\n",
    "# Check ranges of the decision variables\n",
    "print(f\"\\nAlert threshold range: {df['alert_threshold'].min()} to {df['alert_threshold'].max()}\")\n",
    "print(f\"Analysts per shift range: {df['analysts_per_shift'].min()} to {df['analysts_per_shift'].max()}\")\n",
    "print(f\"Total combinations: {len(df)}\")\n",
    "\n",
    "print(f\"\\nDetection rate range: {df['detection_rate'].min():.3f} to {df['detection_rate'].max():.3f}\")\n",
    "print(f\"Cost savings range: ${df['cost_savings'].min():,.0f} to ${df['cost_savings'].max():,.0f}\")\n",
    "\n",
    "# Verify they create a tradeoff\n",
    "correlation = df['detection_rate'].corr(df['cost_savings'])\n",
    "print(f\"\\nCorrelation between objectives: {correlation:.3f}\")\n",
    "print(\"(Negative correlation suggests a tradeoff)\")"
   ]
